# Allowlist: only what the app needs at runtime ships in the archive.
# Everything else (notes, tests, scripts, captures, local databases) stays
# out by default.
/*
!/app.js
!/api.js
!/app.json
!/package.json
!/package-lock.json
!/LICENSE
!/README.txt
!/assets/
!/drivers/
!/lib/
!/locales/
!/settings/
!/widgets/
